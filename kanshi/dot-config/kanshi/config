#include /etc/kanshi/config.d/*

profile internal {
    output eDP-1 enable scale 1.5
    exec sleep 10 && makoctl reload
}

profile all1 {
    output eDP-1 enable mode 2160x1440@60Hz position 0,200 scale 1.75
    output HDMI-A-1 enable mode 2560x1440@60Hz position 1234,0 scale 1.5
    exec sleep 10 && makoctl reload
}

profile no-external {
    output eDP-1 enable scale 1.5
    output HDMI-A-1 disable
    exec sleep 10 && makoctl reload
}
